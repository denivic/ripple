{"nodes": [{"id": "plan_v1_document", "label": "plan-v1.md (Ripple Implementation Plan)", "file_type": "document", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_ripple_thesis", "label": "Ripple (deferred-cost thesis)", "file_type": "rationale", "rationale": "Bad habits are hard to quit because their cost is deferred and invisible; Ripple makes the cumulative cost of a habit immediate and legible (e.g. '61 hours and 9 days of life expectancy this year'). The name is the thesis: a small repeated action propagates outward into something far larger than its origin.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_tauri", "label": "Tauri 2", "file_type": "concept", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_svelte", "label": "Svelte 5", "file_type": "concept", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_typescript", "label": "TypeScript", "file_type": "concept", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_vite", "label": "Vite", "file_type": "concept", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_d3", "label": "d3 (d3-scale/d3-shape/d3-array/d3-time-format)", "file_type": "concept", "rationale": "Used as math, not as renderer -- charts are hand-rendered SVG driven by d3 scales so every element can reference CSS theme variables.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_rusqlite", "label": "rusqlite (bundled SQLite)", "file_type": "concept", "rationale": "Bundled build chosen for zero system dependency and identical behaviour on both Windows and macOS.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_calamine", "label": "calamine (xlsx reader crate)", "file_type": "concept", "rationale": "Chosen as the fastest pure-Rust xlsx reader with lazy sheet decode.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_rust_xlsxwriter", "label": "rust_xlsxwriter (xlsx writer crate)", "file_type": "concept", "rationale": "Write-only crate, which is all the editor needs for export.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_gitbutler", "label": "GitButler (reference implementation)", "file_type": "concept", "rationale": "Cited as the reference implementation of the exact Tauri+Rust+Svelte combination (~21.6k stars), justifying the stack choice.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_electron", "label": "Electron", "file_type": "concept", "rationale": "Explicitly rejected for weight -- ships a whole Chromium (~120 MB) per app to render what the OS can already render, versus Tauri's 8-12 MB installers.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_egui_iced", "label": "egui/iced", "file_type": "concept", "rationale": "Explicitly rejected because the apple-design skill's CSS/web-platform vocabulary is unusable in these native Rust GUI toolkits.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_echarts_chart_js", "label": "ECharts/Chart.js", "file_type": "concept", "rationale": "Explicitly rejected -- canvas-based, cannot inherit CSS theme tokens, and are duration-tweened rather than spring-driven.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_handsontable_ag_grid", "label": "Handsontable/AG Grid", "file_type": "concept", "rationale": "Explicitly rejected for licensing and styling that fights the app's theme system.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_hexagonal_architecture", "label": "Hexagonal Architecture (Ports & Adapters)", "file_type": "rationale", "rationale": "Rust side is organized as domain (pure, no I/O) / application (use cases) / infrastructure (db, import, export, fs) / interface (tauri commands), so domain math stays testable and infrastructure concerns stay swappable.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_repository_pattern", "label": "Repository Pattern", "file_type": "rationale", "rationale": "trait EntryRepository keeps domain math testable without a database.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_strategy_adapter_pattern", "label": "Strategy/Adapter Pattern (TabularSource)", "file_type": "rationale", "rationale": "trait TabularSource { fn sheets(&self) -> Result<Vec<Sheet>> } makes xlsx, csv and numbers interchangeable behind one interface, so adding .ods later is one file.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_command_pattern", "label": "Command Pattern (Grid Undo/Redo)", "file_type": "rationale", "rationale": "The grid's undo/redo stack lives in the frontend so keystrokes never round-trip IPC; persistence is debounced.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_observer_pattern", "label": "Observer Pattern (ripple://data-changed)", "file_type": "rationale", "rationale": "Rust emits ripple://data-changed; stores patch; $derived recomputes; charts spring to the new geometry -- this is the app's real-time requirement.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_builder_pattern", "label": "Builder Pattern (Chart Option Assembly)", "file_type": "rationale", "rationale": "Chart option assembly is built from theme tokens plus series config.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_dto_boundary_pattern", "label": "DTO Boundary Pattern", "file_type": "rationale", "rationale": "Domain types never cross IPC directly; serde DTOs do.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_theme_format", "label": "Theme Format (JSON Token File)", "file_type": "concept", "rationale": "A flat JSON token file mapped 1:1 onto CSS custom properties on :root; derived shades come from color-mix()/oklch() in CSS rather than being enumerated, so a theme file stays ~40 lines.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_apple_design_skill", "label": "apple-design skill", "file_type": "concept", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_dataviz_skill", "label": "dataviz skill", "file_type": "concept", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_cost_model", "label": "Cost Model (time/life split)", "file_type": "rationale", "rationale": "'True time lost' is explicitly time spent + life shortened, shown as two stacked bands, never silently merged; both labelled as estimates with the assumption visible and editable, per the apple-design skill's Responsibility principle -- no medical claims.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_widmark_bac", "label": "Widmark BAC Model", "file_type": "concept", "rationale": "Weight + sex feed a Widmark BAC estimate for alcohol entries; caffeine volume-of-distribution feeds the sleep-debt estimate.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_waking_life_share", "label": "Waking-Life Share Formula", "file_type": "rationale", "rationale": "time_lost / (waking_hours x days) is the honest denominator, not calendar time -- fed by the profile's typical sleep hours.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_numbers_reader", "label": ".numbers Reader (hand-rolled IWA decoder)", "file_type": "rationale", "rationale": "No mature Rust crate exists for .numbers (litchi is a placeholder; only mature reader is Python's numbers-parser). A narrow, read-only, tables-only decoder is hand-rolled on snap + raw protobuf, decoded schema-lessly into a generic wire-format field tree navigated by known field numbers rather than compiling Apple's full .proto set -- less code, more tolerant of version drift. Biggest risk the author cannot close alone: no real .numbers file can be produced on Windows, so end-to-end verification needs real fixtures.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_ledger", "label": "Ledger (Spreadsheet Editor)", "file_type": "concept", "rationale": "Virtualized DOM grid, ~40 visible rows regardless of dataset size; typed cells, multi-sheet tabs, insert/delete rows/columns, undo/redo, TSV copy-paste, fill-down, sort, filter, inline validation errors; an import mapping step maps arbitrary columns onto habit/occurred_at/quantity/duration/note and remembers the mapping per source file.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_today_section", "label": "Today (Section)", "file_type": "concept", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_timeline_section", "label": "Timeline (Section)", "file_type": "concept", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_profile_section", "label": "Profile (Section)", "file_type": "concept", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_settings_section", "label": "Settings (Section)", "file_type": "concept", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_cumulative_ripple_chart", "label": "Cumulative Ripple Chart", "file_type": "concept", "rationale": "Hero chart: stacked cumulative hours with a dashed forward projection cone.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_daily_weekly_bars_chart", "label": "Daily/Weekly Bars + Moving Average Chart", "file_type": "concept", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_calendar_heatmap_chart", "label": "Calendar Heatmap Chart", "file_type": "concept", "rationale": "Full year, intensity = minutes lost.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_hour_weekday_matrix_chart", "label": "Hour x Weekday Matrix Chart", "file_type": "concept", "rationale": "Surfaces triggers by cross-referencing hour-of-day and day-of-week.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_habit_breakdown_chart", "label": "Habit Breakdown Chart", "file_type": "concept", "rationale": "Sorted horizontal bars, toggling time / money / life-minutes.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_streak_counter", "label": "Streak + Clean-Days Counter", "file_type": "concept", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_period_compare_chart", "label": "Period Compare Chart", "file_type": "concept", "rationale": "This month vs last, with signed delta labels.", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_phase1", "label": "Phase 1: Scaffold", "file_type": "concept", "source_file": "plan-v1.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "plan_v1_phase2", "